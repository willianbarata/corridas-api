# Chave secreta que o n8n envia em "Authorization: Bearer <API_KEY>" (obrigatória)
API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Endereço público da API (usado nos links de download e no webhook). Ex.: https://corridas-api.seudominio.com
PUBLIC_URL=

# Segundos sugeridos para o n8n tentar de novo enquanto o vídeo não fica pronto
RETRY_SECONDS=30

# Porta interna (o Easypanel faz o proxy)
PORT=3000
